<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Postzilla.Views.RequestEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Postzilla.Views"
    xmlns:models="using:Postzilla.Models"
    PreviewKeyDown="Root_PreviewKeyDown">
    <Grid Padding="16,12,16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- URL bar -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="MethodBox" Width="120" SelectionChanged="MethodBox_SelectionChanged" FontWeight="SemiBold" />
            <TextBox x:Name="UrlBox" Grid.Column="1" FontFamily="{StaticResource CodeFont}" IsSpellCheckEnabled="False"
                     PlaceholderText="Enter URL, use {{variables}}, or paste a cURL command"
                     TextChanged="UrlBox_TextChanged" Paste="UrlBox_Paste" KeyDown="UrlBox_KeyDown" />
            <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" MinWidth="90" Click="Send_Click"
                    Content="Send" ToolTipService.ToolTip="Send (Ctrl+Enter or F5)" />
            <Button Grid.Column="3" Click="Save_Click" ToolTipService.ToolTip="Save (Ctrl+S)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" ToolTipService.ToolTip="More">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Copy as cURL" Click="CopyCurl_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Replace with cURL command…" Click="ImportCurl_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DocsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Request side -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="RequestTabs" SelectionChanged="RequestTabs_SelectionChanged">
                    <SelectorBarItem x:Name="ParamsTab" Text="Params" IsSelected="True" />
                    <SelectorBarItem x:Name="BodyTab" Text="Body" />
                    <SelectorBarItem x:Name="HeadersTab" Text="Headers" />
                    <SelectorBarItem x:Name="AuthTab" Text="Auth" />
                </SelectorBar>

                <Grid Grid.Row="1">
                    <views:KeyValueEditor x:Name="ParamsEditor" />

                    <Grid x:Name="BodyPanel" Visibility="Collapsed" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="BodyModeBox" Width="190" SelectionChanged="BodyModeBox_SelectionChanged" />
                            <Button x:Name="PrettifyButton" Content="Prettify" Click="Prettify_Click" ToolTipService.ToolTip="Format (Shift+Alt+F)" />
                            <Button x:Name="FetchSchemaButton" Click="FetchSchema_Click" ToolTipService.ToolTip="Run an introspection query against this URL">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Fetch schema" />
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="DocsToggle" Checked="DocsToggle_Changed" Unchecked="DocsToggle_Changed"
                                          ToolTipService.ToolTip="Show schema docs (F1 in the query looks up the item under the cursor)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE82D;" FontSize="14" />
                                    <TextBlock Text="Docs" />
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock x:Name="SchemaStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="NoBodyText" Text="This request does not have a body." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4" />
                            <views:CodeEditor x:Name="BodyBox" />
                            <views:KeyValueEditor x:Name="FormEditor" />
                            <Grid x:Name="GraphQLPanel">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="80" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="0.45*" MinHeight="60" />
                                </Grid.RowDefinitions>
                                <views:CodeEditor x:Name="QueryBox" CodeLanguage="graphql"
                                                  Placeholder="query { … }   — Ctrl+Space: suggestions · F1: docs · Shift+Alt+F: format" />
                                <views:PaneSplitter Grid.Row="1" IsHorizontal="True" Target="0" ToolTipService.ToolTip="Drag to resize · double-click to reset" />
                                <Grid Grid.Row="2" Margin="0,0,0,6" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Variables (JSON)" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="1" Click="InlineVariables_Click" Padding="8,2" FontSize="12"
                                            ToolTipService.ToolTip="Replace $variables in the query with their values from this JSON, and remove them from here">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                            <TextBlock Text="Into query" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Click="ExtractVariables_Click" Padding="8,2" FontSize="12"
                                            ToolTipService.ToolTip="Turn literal argument values in the query into $variables and move the values into this JSON">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                            <TextBlock Text="Out of query" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <views:CodeEditor x:Name="VariablesBox" Grid.Row="3" CodeLanguage="json" Placeholder="{}{ &quot;name&quot;: &quot;value&quot; }" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <views:KeyValueEditor x:Name="HeadersEditor" Visibility="Collapsed" />

                    <ScrollViewer x:Name="AuthPanel" Visibility="Collapsed">
                        <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left" Padding="0,4,0,0">
                            <ComboBox x:Name="AuthModeBox" Header="Type" Width="220" SelectionChanged="AuthModeBox_SelectionChanged" />
                            <TextBox x:Name="AuthTokenBox" Header="Token" FontFamily="{StaticResource CodeFont}" TextChanged="AnyText_Changed" />
                            <TextBox x:Name="AuthUserBox" Header="Username" TextChanged="AnyText_Changed" />
                            <TextBox x:Name="AuthPasswordBox" Header="Password" TextChanged="AnyText_Changed" />
                            <TextBox x:Name="ApiKeyNameBox" Header="Header name" TextChanged="AnyText_Changed" />
                            <TextBox x:Name="ApiKeyValueBox" Header="Value" FontFamily="{StaticResource CodeFont}" TextChanged="AnyText_Changed" />
                            <TextBlock x:Name="AuthHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Values may use {{variables}} from the collection and active environment." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <views:PaneSplitter Grid.Column="1" Width="16" Margin="4,0" ToolTipService.ToolTip="Drag to resize · double-click to reset" />

            <!-- Response side -->
            <Grid Grid.Column="2" RowSpacing="8" Padding="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <SelectorBar x:Name="ResponseTabs" SelectionChanged="ResponseTabs_SelectionChanged">
                        <SelectorBarItem x:Name="ResponseBodyTab" Text="Response" IsSelected="True" />
                        <SelectorBarItem x:Name="ResponseHeadersTab" Text="Headers" />
                    </SelectorBar>
                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                        <TextBlock x:Name="StatusText" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TimeText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SizeText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <views:CodeEditor x:Name="ResponseBodyBox" IsReadOnly="True" WordWrap="True" Placeholder="Send a request to see the response." />
                    <ListView x:Name="ResponseHeadersList" Visibility="Collapsed" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyValueItem">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Key}" FontWeight="SemiBold" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="{StaticResource CodeFont}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <views:PaneSplitter x:Name="DocsSplitter" Grid.Column="3" Target="4" Width="16" Margin="4,0,0,0" Visibility="Collapsed"
                                ToolTipService.ToolTip="Drag to resize docs · double-click to reset" />
            <views:GraphQLDocsPanel x:Name="DocsPanel" Grid.Column="4" CloseRequested="DocsPanel_CloseRequested" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
