<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Postzilla.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Postzilla.Views">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="SaveAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="SendAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="SendAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="NewTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="CloseTabAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Text="Postzilla" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="TitleEnvBadge" CornerRadius="4" Padding="8,2,8,3" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="TitleEnvText" FontSize="11" FontWeight="Bold" CharacterSpacing="40" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="640" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,1,1,0" CornerRadius="0,8,0,0" RowSpacing="4" Padding="4,8,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="8,0,0,0">
                    <TextBlock Text="Collections" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Click="ExpandAll_Click" AutomationProperties.Name="Expand all" ToolTipService.ToolTip="Expand all">
                            <FontIcon Glyph="&#xE972;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="CollapseAll_Click" AutomationProperties.Name="Collapse all" ToolTipService.ToolTip="Collapse all">
                            <FontIcon Glyph="&#xE971;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="NewCollection_Click" ToolTipService.ToolTip="New collection">
                            <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="Import_Click" ToolTipService.ToolTip="Import collection (Postzilla or Postman v2.x JSON)">
                            <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="PasteCurl_Click" ToolTipService.ToolTip="New request from cURL">
                            <FontIcon Glyph="&#xE77F;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TreeView x:Name="CollectionTree" Grid.Row="1" ItemsSource="{x:Bind RootEntries}" SelectionMode="Single"
                          ItemInvoked="CollectionTree_ItemInvoked" RightTapped="CollectionTree_RightTapped" CanDragItems="True" CanReorderItems="False" AllowDrop="True" DragItemsStarting="CollectionTree_DragItemsStarting" DragItemsCompleted="CollectionTree_DragItemsCompleted"
                          Expanding="CollectionTree_Expanding" Collapsed="CollectionTree_Collapsed">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="views:TreeEntry">
                            <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                                          AllowDrop="True" Loaded="TreeItem_Loaded">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Visibility="{x:Bind GlyphVisibility}" />
                                    <TextBlock Text="{x:Bind MethodLabel}" Foreground="{x:Bind MethodBrush}" Visibility="{x:Bind MethodVisibility}"
                                               FontSize="11" FontWeight="Bold" Width="32" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock x:Name="EmptyHint" Grid.Row="1" Margin="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No collections yet. Create one, import a Postman/Postzilla file, or save a request." />
                <Grid Grid.Row="2" ColumnSpacing="6" Padding="8,8,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="EnvironmentBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="EnvironmentBox_SelectionChanged"
                              ToolTipService.ToolTip="Active environment" />
                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="ManageEnvironments_Click" ToolTipService.ToolTip="Manage environments">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="About_Click" ToolTipService.ToolTip="About Postzilla">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
            <views:PaneSplitter Target="0" ShowLine="False" HorizontalAlignment="Right" Canvas.ZIndex="1"
                                ToolTipService.ToolTip="Drag to resize · double-click to reset" />

            <!-- Main area -->
            <TabView x:Name="Tabs" Grid.Column="1" VerticalAlignment="Stretch" AddTabButtonClick="Tabs_AddTabButtonClick" TabCloseRequested="Tabs_TabCloseRequested"
                     TabWidthMode="SizeToContent" CanReorderTabs="True" />
        </Grid>
    </Grid>
</Window>
